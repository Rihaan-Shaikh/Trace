# TRACE Environment Variables
# Copy to .env for local development

# Application
APP_NAME="TRACE Decision Underwriting Engine"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-in-production"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trace_dev"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trace_test"

# LLM Provider Configuration
# Architecture: One LLM + Structured Specialist Roles + Deterministic Analytics
# Provider choices: mock, openai, anthropic, gemini
LLM_PROVIDER="mock"
LLM_MODEL="mock-trace-v1"
LLM_API_KEY=""

# Rate Card Starting Defaults
WEIGHT_DATA_QUALITY_LOAD=0.10
WEIGHT_VERIFICATION_LOAD=0.05
WEIGHT_CONTRADICTION_LOAD=1.00
BASE_MODEL_UNCERTAINTY_WEIGHT=0.05

BAND_RECOMMENDED_MAX_RATE=0.10
BAND_RECOMMENDED_WITH_CONDITIONS_MAX_RATE=0.25
BAND_REFER_MAX_RATE=0.50
TAIL_PERCENTILE=0.10
SCENARIO_SIMULATION_COUNT=1000
SCENARIO_DEFAULT_SEED=42
